{
  "name": "Inventario",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero do Invent\u00e1rio",
      "description": "Identificador \u00fanico sequencial global (ex.: INV-000001). Gerado automaticamente."
    },
    "data": {
      "type": "string",
      "format": "date-time",
      "title": "Data e Hora de Abertura"
    },
    "data_fechamento": {
      "type": "string",
      "format": "date-time",
      "title": "Data e Hora de Conclus\u00e3o"
    },
    "setor_id": {
      "type": "string",
      "title": "Setor"
    },
    "setor_nome": {
      "type": "string",
      "title": "Setor (nome)"
    },
    "criterios": {
      "type": "string",
      "title": "Crit\u00e9rios",
      "description": "JSON can\u00f4nico com os crit\u00e9rios de filtro: deposito_id, gaveta_id, maquina_id. Usado para evitar documentos duplicados em aberto do mesmo setor/crit\u00e9rio."
    },
    "criterios_descricao": {
      "type": "string",
      "title": "Crit\u00e9rios (descri\u00e7\u00e3o)"
    },
    "itens": {
      "type": "string",
      "title": "Itens Conferidos",
      "description": "JSON array consolidado na conclus\u00e3o: produto_id, codigo, nome, unidade, qtd_sistema, qtd_contada, divergencia, status, responsavel."
    },
    "total_itens": {
      "type": "number",
      "title": "Total de Itens",
      "default": 0
    },
    "total_acertos": {
      "type": "number",
      "title": "Acertos",
      "default": 0
    },
    "total_divergencias": {
      "type": "number",
      "title": "Diverg\u00eancias",
      "default": 0
    },
    "resultado": {
      "type": "string",
      "enum": [
        "consistente",
        "divergente"
      ],
      "title": "Resultado",
      "default": "consistente"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "concluido"
      ],
      "title": "Status",
      "description": "aberto = documento em confer\u00eancia (v\u00e1rios usu\u00e1rios podem preencher); concluido = fechado e registrado.",
      "default": "aberto"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel (abertura)"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "data",
    "setor_id"
  ]
}