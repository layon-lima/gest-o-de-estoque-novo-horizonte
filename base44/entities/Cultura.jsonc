{
  "name": "Cultura",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome",
      "description": "Nome da cultura (ex.: Milho, Soja, Algod\u00e3o)."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}