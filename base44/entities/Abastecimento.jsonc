{
  "name": "Abastecimento",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date-time",
      "title": "Data e Hora"
    },
    "maquina_id": {
      "type": "string",
      "title": "M\u00e1quina",
      "description": "M\u00e1quina abastecida"
    },
    "produto_id": {
      "type": "string",
      "title": "Combust\u00edvel",
      "description": "Produto do setor de Combust\u00edveis baixado do estoque"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade"
    },
    "unidade": {
      "type": "string",
      "title": "Unidade",
      "default": "un"
    },
    "operador": {
      "type": "string",
      "title": "Operador",
      "description": "Nome do usu\u00e1rio que realizou o abastecimento"
    },
    "numero_mov": {
      "type": "string",
      "title": "Movimenta\u00e7\u00e3o Vinculada",
      "description": "N\u00famero da movimenta\u00e7\u00e3o de sa\u00edda gerada na confirma\u00e7\u00e3o da baixa"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmado",
        "cancelado"
      ],
      "title": "Status",
      "description": "Pendente = aguardando confirma\u00e7\u00e3o da baixa por usu\u00e1rio autorizado.",
      "default": "pendente"
    },
    "foto_url": {
      "type": "string",
      "title": "Foto do Painel",
      "description": "Foto do painel do abastecedor tirada pelo operador, usada na confirma\u00e7\u00e3o da baixa."
    },
    "confirmado_por": {
      "type": "string",
      "title": "Confirmado Por",
      "description": "Nome do usu\u00e1rio que confirmou a baixa"
    },
    "data_confirmacao": {
      "type": "string",
      "format": "date-time",
      "title": "Data da Confirma\u00e7\u00e3o"
    }
  },
  "required": [
    "data",
    "maquina_id",
    "produto_id",
    "quantidade"
  ]
}