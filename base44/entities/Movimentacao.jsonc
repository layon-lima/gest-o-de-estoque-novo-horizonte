{
  "name": "Movimentacao",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date-time",
      "title": "Data e Hora"
    },
    "produto_id": {
      "type": "string",
      "title": "Produto",
      "description": "Refer\u00eancia ao Produto"
    },
    "codigo": {
      "type": "string",
      "title": "C\u00f3digo do Produto"
    },
    "nome_produto": {
      "type": "string",
      "title": "Nome do Produto"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade"
    },
    "setor_id": {
      "type": "string",
      "title": "Setor"
    },
    "maquina_id": {
      "type": "string",
      "title": "M\u00e1quina"
    },
    "gaveta_id": {
      "type": "string",
      "title": "Gaveta"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "estorno"
      ],
      "title": "Tipo",
      "default": "entrada"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "numero_nf": {
      "type": "string",
      "title": "N\u00famero da NF"
    },
    "fornecedor": {
      "type": "string",
      "title": "Fornecedor"
    },
    "chave_acesso": {
      "type": "string",
      "title": "Chave de Acesso da NF-e"
    },
    "lote_id": {
      "type": "string",
      "title": "Lote",
      "description": "Refer\u00eancia ao Lote (setores com controle de validade)"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "title": "Data de Validade"
    },
    "lotes_consumidos": {
      "type": "string",
      "title": "Lotes Consumidos (FEFO)",
      "description": "JSON com os lotes consumidos em uma sa\u00edda"
    }
  },
  "required": [
    "data",
    "produto_id",
    "quantidade",
    "tipo"
  ]
}