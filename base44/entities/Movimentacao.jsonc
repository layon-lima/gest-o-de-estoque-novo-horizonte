{
  "name": "Movimentacao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero da Movimenta\u00e7\u00e3o",
      "description": "Identificador \u00fanico sequencial de cada movimenta\u00e7\u00e3o de estoque (ex.: MOV-000001)."
    },
    "data": {
      "type": "string",
      "format": "date-time",
      "title": "Data e Hora"
    },
    "produto_id": {
      "type": "string",
      "title": "Produto",
      "description": "Refer\u00eancia ao Produto"
    },
    "codigo": {
      "type": "string",
      "title": "C\u00f3digo do Produto"
    },
    "nome_produto": {
      "type": "string",
      "title": "Nome do Produto"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade"
    },
    "custo_unitario": {
      "type": "number",
      "title": "Custo Unit\u00e1rio (R$)",
      "description": "Custo unit\u00e1rio do produto na origem da movimenta\u00e7\u00e3o (ex.: vUnCom da NF-e em entradas).",
      "default": 0
    },
    "valor_movimentado": {
      "type": "number",
      "title": "Valor Movimentado (R$)",
      "description": "Valor financeiro total da movimenta\u00e7\u00e3o (ex.: vProd da NF-e em entradas = quantidade \u00d7 custo unit\u00e1rio).",
      "default": 0
    },
    "setor_id": {
      "type": "string",
      "title": "Setor"
    },
    "deposito_id": {
      "type": "string",
      "title": "Dep\u00f3sito",
      "description": "Dep\u00f3sito onde a movimenta\u00e7\u00e3o ocorreu (origem ou destino do saldo)."
    },
    "maquina_id": {
      "type": "string",
      "title": "M\u00e1quina"
    },
    "gaveta_id": {
      "type": "string",
      "title": "Gaveta"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "estorno"
      ],
      "title": "Tipo",
      "default": "entrada"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "numero_nf": {
      "type": "string",
      "title": "N\u00famero da NF"
    },
    "fornecedor": {
      "type": "string",
      "title": "Fornecedor"
    },
    "chave_acesso": {
      "type": "string",
      "title": "Chave de Acesso da NF-e"
    },
    "lote_id": {
      "type": "string",
      "title": "Lote",
      "description": "Refer\u00eancia ao Lote (setores com controle de validade)"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "title": "Data de Validade"
    },
    "lotes_consumidos": {
      "type": "string",
      "title": "Lotes/Saldos Consumidos (FEFO)",
      "description": "JSON com os saldos consumidos em uma sa\u00edda"
    },
    "estornada": {
      "type": "boolean",
      "title": "Estornada",
      "description": "Indica se esta movimenta\u00e7\u00e3o foi estornada (cascata de auditoria)",
      "default": false
    }
  },
  "required": [
    "data",
    "produto_id",
    "quantidade",
    "tipo"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}