{
  "name": "Pagamento",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero do Pagamento",
      "description": "Identificador \u00fanico sequencial (ex.: PAG-000001). Gerado automaticamente."
    },
    "pedido_id": {
      "type": "string",
      "title": "Pedido",
      "description": "Refer\u00eancia ao PedidoPesagem vinculado."
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente",
      "description": "Refer\u00eancia ao Cliente (espelhado do pedido no momento do registro)."
    },
    "valor": {
      "type": "number",
      "title": "Valor Pago (R$)",
      "default": 0
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "transferencia",
        "boleto",
        "cartao",
        "cheque",
        "outro"
      ],
      "title": "Forma de Pagamento",
      "default": "pix"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date-time",
      "title": "Data do Pagamento"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "pedido_id",
    "valor",
    "data_pagamento"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}