{
  "name": "Veiculo",
  "type": "object",
  "properties": {
    "placa": {
      "type": "string",
      "title": "Placa",
      "description": "Placa do ve\u00edculo (normalizada e \u00fanica)."
    },
    "modelo": {
      "type": "string",
      "title": "Modelo",
      "description": "Modelo/marca do ve\u00edculo (ex.: Scania R450)."
    },
    "cor": {
      "type": "string",
      "title": "Cor"
    },
    "ano": {
      "type": "string",
      "title": "Ano"
    },
    "tara": {
      "type": "number",
      "title": "Tara (kg)",
      "description": "Peso vazio do ve\u00edculo (cavalo + carreta).",
      "default": 0
    },
    "capacidade_kg": {
      "type": "number",
      "title": "Capacidade (kg)",
      "description": "Carga \u00fatil m\u00e1xima do ve\u00edculo.",
      "default": 0
    },
    "transportadora_id": {
      "type": "string",
      "title": "Transportadora",
      "description": "Refer\u00eancia \u00e0 Transportadora propriet\u00e1ria do ve\u00edculo (opcional)."
    },
    "motorista_id": {
      "type": "string",
      "title": "Motorista",
      "description": "Refer\u00eancia \u00e0 Pessoa (motorista) vinculada ao ve\u00edculo (opcional)."
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "placa"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}