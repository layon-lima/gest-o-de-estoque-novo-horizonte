{
  "name": "Produto",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "title": "C\u00f3digo Interno"
    },
    "codigo_referencia": {
      "type": "string",
      "title": "C\u00f3digo de Refer\u00eancia",
      "description": "Definido pelo usu\u00e1rio no momento da entrada em estoque"
    },
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "setor_id": {
      "type": "string",
      "title": "Setor",
      "description": "Refer\u00eancia ao Setor"
    },
    "maquina_id": {
      "type": "string",
      "title": "M\u00e1quina",
      "description": "Refer\u00eancia \u00e0 Maquina"
    },
    "gaveta_id": {
      "type": "string",
      "title": "Gaveta",
      "description": "Refer\u00eancia \u00e0 Gaveta"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade",
      "default": 0
    },
    "unidade": {
      "type": "string",
      "title": "Unidade",
      "default": "un"
    },
    "unidade_alt": {
      "type": "string",
      "title": "Unidade Alternativa",
      "description": "Unidade da NF-e que exige convers\u00e3o customizada (ex.: CX, GAL, FR). Quando a NF-e trouxer esta unidade, a quantidade ser\u00e1 multiplicada pelo fator de convers\u00e3o."
    },
    "fator_conversao": {
      "type": "number",
      "title": "Fator de Convers\u00e3o",
      "description": "Quantos da unidade-base equivalem a 1 unidade alternativa (ex.: 1 CX = 50 kg \u2192 fator 50).",
      "default": 0
    },
    "estoque_minimo": {
      "type": "number",
      "title": "Estoque M\u00ednimo",
      "default": 0
    }
  },
  "required": [
    "codigo",
    "nome",
    "setor_id"
  ]
}