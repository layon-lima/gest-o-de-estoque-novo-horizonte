{
  "name": "Produto",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "title": "C\u00f3digo Interno"
    },
    "codigo_referencia": {
      "type": "string",
      "title": "C\u00f3digo de Refer\u00eancia",
      "description": "Definido pelo usu\u00e1rio no momento da entrada em estoque"
    },
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "setor_id": {
      "type": "string",
      "title": "Setor",
      "description": "Refer\u00eancia ao Setor"
    },
    "deposito_id": {
      "type": "string",
      "title": "Dep\u00f3sito",
      "description": "Refer\u00eancia ao Dep\u00f3sito (agrupamento dentro do setor) ao qual o produto pertence."
    },
    "maquina_id": {
      "type": "string",
      "title": "M\u00e1quina",
      "description": "Refer\u00eancia \u00e0 Maquina"
    },
    "gaveta_id": {
      "type": "string",
      "title": "Gaveta",
      "description": "Refer\u00eancia \u00e0 Gaveta"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade",
      "default": 0
    },
    "unidade": {
      "type": "string",
      "title": "Unidade",
      "default": "un"
    },
    "unidade_alt": {
      "type": "string",
      "title": "Unidade Alternativa",
      "description": "Unidade da NF-e que exige convers\u00e3o customizada (ex.: CX, GAL, FR). Quando a NF-e trouxer esta unidade, a quantidade ser\u00e1 multiplicada pelo fator de convers\u00e3o."
    },
    "fator_conversao": {
      "type": "number",
      "title": "Fator de Convers\u00e3o",
      "description": "Quantos da unidade-base equivalem a 1 unidade alternativa (ex.: 1 CX = 50 kg \u2192 fator 50).",
      "default": 0
    },
    "estoque_minimo": {
      "type": "number",
      "title": "Estoque M\u00ednimo",
      "default": 0
    },
    "custo_unitario": {
      "type": "number",
      "title": "Custo Unit\u00e1rio (R$)",
      "description": "Custo por unidade do produto, usado no c\u00e1lculo de custo das Ordens de Servi\u00e7o de Aplica\u00e7\u00e3o. Futuramente ser\u00e1 derivado das notas fiscais.",
      "default": 0
    },
    "venda": {
      "type": "boolean",
      "title": "Produto de Venda",
      "description": "Indica que o produto \u00e9 comercializado e aparece na pesquisa da Pesagem Rodovi\u00e1ria (pedidos e tickets).",
      "default": false
    },
    "foto_url": {
      "type": "string",
      "title": "Foto de Refer\u00eancia",
      "description": "Imagem opcional de refer\u00eancia do produto, anexada no cadastro ou edi\u00e7\u00e3o."
    }
  },
  "required": [
    "codigo",
    "nome",
    "setor_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}