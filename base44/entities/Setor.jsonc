{
  "name": "Setor",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "cor": {
      "type": "string",
      "title": "Cor",
      "default": "#16a34a"
    },
    "icon": {
      "type": "string",
      "title": "\u00cdcone",
      "description": "\u00cdcone que representa o setor na barra mobile. Se vazio, o sistema infere pelo nome (ex.: combust\u00edvel \u2192 bomba, m\u00e1quinas \u2192 trator).",
      "default": ""
    },
    "controla_validade": {
      "type": "boolean",
      "title": "Controla Validade (Lotes)",
      "default": false
    },
    "tem_aba_mobile": {
      "type": "boolean",
      "title": "Tem Aba Mobile",
      "description": "Ativa este setor como op\u00e7\u00e3o na aba mobile 'Setores'. Setores sem esta marca\u00e7\u00e3o n\u00e3o aparecem na lista em cascata para nenhum usu\u00e1rio.",
      "default": false
    },
    "permite_inventario": {
      "type": "boolean",
      "title": "Permite Invent\u00e1rio",
      "description": "Habilita a op\u00e7\u00e3o de Invent\u00e1rio (confer\u00eancia tete-a-tete) dentro da aba mobile deste setor.",
      "default": false
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}