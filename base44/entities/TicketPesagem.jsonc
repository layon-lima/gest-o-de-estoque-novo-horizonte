{
  "name": "TicketPesagem",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero do Ticket",
      "description": "Identificador \u00fanico sequencial (ex.: PES-000001). Gerado automaticamente."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "venda",
        "lavoura",
        "compra",
        "entrada_saida"
      ],
      "title": "Tipo de Pesagem",
      "description": "venda = sa\u00edda para venda (vincula pedido); lavoura = sa\u00edda para lavoura; compra = entrada por compra; entrada_saida = entrada e sa\u00edda.",
      "default": "venda"
    },
    "produto_id": {
      "type": "string",
      "title": "Produto",
      "description": "Produto vinculado ao ticket (lavoura/compra/entrada_saida). Em venda, vem do pedido (definido na abertura)."
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente",
      "description": "Refer\u00eancia ao Cliente. Em venda, vem do pedido (definido na abertura)."
    },
    "cliente_nome": {
      "type": "string",
      "title": "Cliente (nome)",
      "description": "Nome do cliente espelhado para exibi\u00e7\u00e3o r\u00e1pida."
    },
    "transportadora_id": {
      "type": "string",
      "title": "Transportadora",
      "description": "Refer\u00eancia \u00e0 Transportadora. Em venda, vem do pedido (definido na abertura/fechamento)."
    },
    "transportadora_nome": {
      "type": "string",
      "title": "Transportadora (nome)",
      "description": "Nome da transportadora espelhado para exibi\u00e7\u00e3o r\u00e1pida."
    },
    "origem": {
      "type": "string",
      "title": "Origem"
    },
    "destino": {
      "type": "string",
      "title": "Destino"
    },
    "data_abertura": {
      "type": "string",
      "format": "date-time",
      "title": "Data/Hora de Abertura"
    },
    "data_fechamento": {
      "type": "string",
      "format": "date-time",
      "title": "Data/Hora de Fechamento"
    },
    "motorista": {
      "type": "string",
      "title": "Motorista"
    },
    "placa": {
      "type": "string",
      "title": "Placa"
    },
    "peso_tara": {
      "type": "number",
      "title": "Peso Tara (kg)",
      "default": 0
    },
    "peso_bruto": {
      "type": "number",
      "title": "Peso Bruto (kg)",
      "default": 0
    },
    "peso_liquido": {
      "type": "number",
      "title": "Peso L\u00edquido",
      "description": "Calculado: peso_bruto - peso_tara.",
      "default": 0
    },
    "pedido_id": {
      "type": "string",
      "title": "Pedido",
      "description": "Refer\u00eancia ao PedidoPesagem vinculado (definido na abertura em vendas)."
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "fechado"
      ],
      "title": "Status",
      "default": "aberto"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "nfe_importada": {
      "type": "boolean",
      "title": "NF-e Importada",
      "description": "Indica que este ticket de venda j\u00e1 possui nota fiscal vinculada via importa\u00e7\u00e3o de XML.",
      "default": false
    },
    "nfe_numero": {
      "type": "string",
      "title": "N\u00famero da NF-e",
      "description": "N\u00famero da nota fiscal extra\u00eddo do XML importado."
    },
    "nfe_produto": {
      "type": "string",
      "title": "Produto (NF-e)",
      "description": "Descri\u00e7\u00e3o do produto na nota fiscal extra\u00edda do XML."
    },
    "nfe_motorista": {
      "type": "string",
      "title": "Motorista (NF-e)",
      "description": "Nome do motorista/transportador na nota fiscal extra\u00eddo do XML."
    },
    "nfe_chave": {
      "type": "string",
      "title": "Chave de Acesso (NF-e)",
      "description": "Chave de acesso de 44 d\u00edgitos da NF-e. Usada para evitar reimporta\u00e7\u00e3o duplicada."
    }
  },
  "required": [
    "numero",
    "data_abertura",
    "motorista",
    "placa",
    "peso_tara",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}