{
  "name": "TicketPesagem",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "N\u00famero do Ticket",
      "description": "Identificador \u00fanico sequencial (ex.: PES-000001). Gerado automaticamente."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "venda",
        "lavoura",
        "compra",
        "entrada_saida"
      ],
      "title": "Tipo de Pesagem",
      "description": "venda = sa\u00edda para venda (vincula pedido); lavoura = sa\u00edda para lavoura; compra = entrada por compra; entrada_saida = entrada e sa\u00edda.",
      "default": "venda"
    },
    "produto_id": {
      "type": "string",
      "title": "Produto",
      "description": "Produto vinculado ao ticket (lavoura/compra/entrada_saida). Em venda, vem do pedido no fechamento."
    },
    "transportadora_id": {
      "type": "string",
      "title": "Transportadora",
      "description": "Refer\u00eancia \u00e0 Transportadora. Em venda, vem do pedido no fechamento."
    },
    "transportadora_nome": {
      "type": "string",
      "title": "Transportadora (nome)",
      "description": "Nome da transportadora espelhado para exibi\u00e7\u00e3o r\u00e1pida."
    },
    "origem": {
      "type": "string",
      "title": "Origem"
    },
    "destino": {
      "type": "string",
      "title": "Destino"
    },
    "data_abertura": {
      "type": "string",
      "format": "date-time",
      "title": "Data/Hora de Abertura"
    },
    "data_fechamento": {
      "type": "string",
      "format": "date-time",
      "title": "Data/Hora de Fechamento"
    },
    "motorista": {
      "type": "string",
      "title": "Motorista"
    },
    "placa": {
      "type": "string",
      "title": "Placa"
    },
    "peso_tara": {
      "type": "number",
      "title": "Peso Tara (kg)",
      "default": 0
    },
    "peso_bruto": {
      "type": "number",
      "title": "Peso Bruto (kg)",
      "default": 0
    },
    "peso_liquido": {
      "type": "number",
      "title": "Peso L\u00edquido (kg)",
      "description": "Calculado: peso_bruto - peso_tara.",
      "default": 0
    },
    "pedido_id": {
      "type": "string",
      "title": "Pedido",
      "description": "Refer\u00eancia ao PedidoPesagem vinculado no fechamento."
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "fechado"
      ],
      "title": "Status",
      "default": "aberto"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "numero",
    "data_abertura",
    "motorista",
    "placa",
    "peso_tara",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}