      "type": "string",
      "title": "Produto",
      "description": "Refer\u00eancia ao Produto"
    },
    "setor_id": {
      "type": "string",
      "title": "Setor"
    },
    "maquina_id": {
      "type": "string",
      "title": "M\u00e1quina"
    },
    "gaveta_id": {
      "type": "string",
      "title": "Gaveta"
    },
    "codigo_lote": {
      "type": "string",
      "title": "C\u00f3digo do Lote"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "title": "Data de Validade"
