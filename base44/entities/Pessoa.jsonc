{
  "name": "Pessoa",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome / Raz\u00e3o Social"
    },
    "documento": {
      "type": "string",
      "title": "CNPJ / CPF",
      "description": "Documento de identifica\u00e7\u00e3o da empresa ou pessoa."
    },
    "telefone": {
      "type": "string",
      "title": "Telefone"
    },
    "cidade": {
      "type": "string",
      "title": "Cidade"
    },
    "uf": {
      "type": "string",
      "title": "UF",
      "description": "Sigla do estado (ex.: SP, MT, PR)."
    },
    "endereco": {
      "type": "string",
      "title": "Endere\u00e7o",
      "description": "Logradouro, n\u00famero, bairro (opcional)."
    },
    "cnh": {
      "type": "string",
      "title": "CNH",
      "description": "N\u00famero da Carteira Nacional de Habilita\u00e7\u00e3o (apenas motoristas)."
    },
    "cnh_validade": {
      "type": "string",
      "format": "date",
      "title": "Validade da CNH"
    },
    "is_cliente": {
      "type": "boolean",
      "title": "Cliente",
      "description": "Marca esta pessoa como cliente (comprador).",
      "default": false
    },
    "is_fornecedor": {
      "type": "boolean",
      "title": "Fornecedor",
      "description": "Marca esta pessoa como fornecedor.",
      "default": false
    },
    "is_transportadora": {
      "type": "boolean",
      "title": "Transportadora",
      "description": "Marca esta pessoa como transportadora.",
      "default": false
    },
    "is_motorista": {
      "type": "boolean",
      "title": "Motorista",
      "description": "Marca esta pessoa como motorista. Motoristas aparecem na sele\u00e7\u00e3o dos tickets de pesagem.",
      "default": false
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}