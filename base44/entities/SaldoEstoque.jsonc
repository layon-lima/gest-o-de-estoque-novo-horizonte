{
  "name": "SaldoEstoque",
  "type": "object",
  "properties": {
    "produto_id": {
      "type": "string",
      "title": "Produto",
      "description": "Refer\u00eancia ao Produto."
    },
    "deposito_id": {
      "type": "string",
      "title": "Dep\u00f3sito",
      "description": "Dep\u00f3sito onde a quantidade est\u00e1 armazenada."
    },
    "gaveta_id": {
      "type": "string",
      "title": "Gaveta",
      "description": "Gaveta dentro do dep\u00f3sito (opcional)."
    },
    "lote_id": {
      "type": "string",
      "title": "Lote",
      "description": "Lote vinculado (apenas setores com controle de validade)."
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade",
      "default": 0
    },
    "custo_unitario": {
      "type": "number",
      "title": "Custo Unit\u00e1rio (R$)",
      "description": "Custo unit\u00e1rio de aquisi\u00e7\u00e3o desta parcela (ex.: vUnCom da NF-e de entrada).",
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "title": "Valor Total (R$)",
      "description": "Valor financeiro da parcela = quantidade \u00d7 custo_unitario. Mantido automaticamente pelas opera\u00e7\u00f5es de saldo.",
      "default": 0
    },
    "unidade": {
      "type": "string",
      "title": "Unidade",
      "default": "un"
    }
  },
  "required": [
    "produto_id",
    "deposito_id",
    "quantidade"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}